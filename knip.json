{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/main.tsx",
    "src/App.tsx",
    "vite.config.ts",
    "tailwind.config.ts",
    "postcss.config.js",
    "eslint.config.js",
    "src/test/**/*.{ts,tsx}",
    "supabase/functions/**/index.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "supabase/functions/**/*.{ts,tsx}"
  ],
  "ignore": [
    "src/integrations/supabase/types.ts",
    "src/components/ui/**",
    "src/vite-env.d.ts",
    "supabase/functions/_shared/email-templates/**"
  ],
  "ignoreDependencies": [
    "tailwindcss",
    "autoprefixer",
    "postcss",
    "@types/*"
  ],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "files": "error",
    "dependencies": "error",
    "unlisted": "error",
    "binaries": "error",
    "exports": "warn",
    "types": "warn",
    "nsExports": "warn",
    "nsTypes": "warn",
    "duplicates": "warn",
    "enumMembers": "warn",
    "classMembers": "warn"
  }
}
