{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/main.tsx",
    "src/App.tsx",
    "vite.config.ts",
    "tailwind.config.ts",
    "postcss.config.js",
    "eslint.config.js",
    "src/test/**/*.{ts,tsx}"
  ],
  "project": [
    "src/**/*.{ts,tsx}"
  ],
  "ignore": [
    "src/integrations/supabase/types.ts",
    "src/components/ui/**",
    "src/hooks/use-mobile.tsx",
    "src/vite-env.d.ts",
    "supabase/**"
  ],
  "ignoreDependencies": [
    "tailwindcss",
    "autoprefixer",
    "postcss",
    "@types/*",
    "@radix-ui/react-aspect-ratio",
    "@radix-ui/react-context-menu",
    "@radix-ui/react-menubar",
    "@radix-ui/react-navigation-menu",
    "embla-carousel-react",
    "react-resizable-panels",
    "vaul",
    "@tailwindcss/typography"
  ],
  "ignoreBinaries": ["tsgo"],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "files": "error",
    "dependencies": "error",
    "unlisted": "error",
    "binaries": "error",
    "exports": "warn",
    "types": "warn",
    "nsExports": "warn",
    "nsTypes": "warn",
    "duplicates": "warn",
    "enumMembers": "warn"
  }
}
